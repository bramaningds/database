Table products {
  id integer [primary key, increment]
  name varchar [unique]
  description text
  price double
  created_at datetime
  updated_at datetime
}

Table transactions {
  id integer [primary key, increment]
  sold_at datetime
  created_at datetime
  updated_at datetime
}

Table transaction_details {
  id integer [primary key, increment]
  transaction_id integer [ref: > transactions.id]
  product_id integer [ref: > products.id]
  quantity double
  price double
}